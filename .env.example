# Required when the desk runs in Docker. The container binds 0.0.0.0 inside its
# own network namespace (Docker port publishing needs that) and the state server
# refuses a non-loopback bind without a token. Compose still publishes the port
# on the host's 127.0.0.1 only. Generate one: openssl rand -hex 24
STABLEBOT_DESK_TOKEN=

# Official X API v2 bearer token (optional). Without it, price logic still runs.
X_BEARER_TOKEN=

# Never place live orders in this version. Leave unset.
LIVE=0

# Optional: override project root / config path
# STABLEBOT_ROOT=/workspace/crypto-bot
# STABLEBOT_CONFIG=/workspace/crypto-bot/config.yaml

# Polymarket live is OFF unless several independent gates all pass.
# Leave POLY_LIVE=0. Do not set this to 1 in a file you commit.
POLY_LIVE=0
POLY_PK=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
POLY_FUNDER=
POLY_SIGNATURE_TYPE=
POLY_BUILDER_CODE=

# Confirm file (do not create until you accept live risk):
#   {project}/data/poly_live_confirm.txt
#   contents must be exactly: I_ACCEPT_LIVE_POLY_ORDERS
# Halt file (stops live sending if present):
#   {project}/data/poly_halt
