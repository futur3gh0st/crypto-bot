data/kalshi_run.log

# --- Backtest artifacts + data caches (large, regenerable) ---
data/backtests/*.json
data/backtests/*.csv
data/backtests/cache/
data/bt_cache/
data/spot_lag_bt/
data/poly_cache/

# local report, not part of the repo
report.html
